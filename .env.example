# ───────── GolfUs — variables d'environnement ─────────
# Copiez ce fichier en .env puis adaptez les valeurs.
# Toutes ces variables sont lues UNIQUEMENT par le serveur : aucune n'est envoyée au navigateur.

# Port du serveur API en développement (Vite proxifie /api vers ce port).
# En production, l'hébergeur fournit généralement PORT, utilisé si API_PORT est vide.
API_PORT=8787

# Administration (/admin) : mot de passe et secret de signature des sessions.
# Générez des valeurs longues et aléatoires, par ex. : openssl rand -base64 24
ADMIN_PASSWORD=change-moi
ADMIN_SESSION_SECRET=change-moi-aussi-avec-une-longue-chaine-aleatoire

# Base Postgres : en ligne, Netlify Database fournit NETLIFY_DB_URL automatiquement.
# En local, PGlite (Postgres intégré) stocke les données dans ce dossier.
DATABASE_DIR=./data/pglite

# Afficher les golfs de démonstration du script de seed (true/false)
SHOW_DEMO_DATA=true

# Durée du cache des réponses d'API, en heures
CACHE_TTL_HOURS=24

# Identification auprès des services OpenStreetMap (exigé par leurs conditions d'usage).
# Mettez une adresse de contact pour l'exploitant du site.
CONTACT_EMAIL=

# Serveurs Overpass (OpenStreetMap), essayés dans l'ordre, séparés par des virgules
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Calcul d'itinéraires
# - Sans clé : serveur de démonstration OSRM (gratuit, usage modéré).
# - Optionnel : clé gratuite OpenRouteService (https://openrouteservice.org/dev/#/signup), plus fiable.
OSRM_URL=https://router.project-osrm.org
ORS_API_KEY=

# ───── Comptes utilisateurs (Auth.js) ─────
# Secret de signature des sessions (obligatoire) : openssl rand -base64 33
AUTH_SECRET=
# Envoi d'e-mails (lien magique, mot de passe oublié) — facultatif, ex. smtp://utilisateur:motdepasse@smtp.exemple.com:587
EMAIL_SERVER=
EMAIL_FROM=GolfUs <no-reply@golfus.app>
# « Continuer avec Google » (console.cloud.google.com) — facultatif
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# « Continuer avec Apple » (developer.apple.com, 99 $/an) — facultatif
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
