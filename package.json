{
  "name": "golfus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trouvez et comparez les golfs autour de votre lieu de vacances",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "test": "DATABASE_PATH=:memory: tsx --test server/**/*.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/database": "^2.0.1",
    "@tanstack/react-query": "^5.104.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.0.13",
    "opening_hours": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
