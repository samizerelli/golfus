{
  "name": "golfus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trouvez et comparez les golfs autour de votre lieu de vacances",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && npm run check:data && vite build",
    "build:ios": "tsc -b && npm run check:data && vite build --mode ios --outDir dist-ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:sim": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "seed": "tsx --env-file-if-exists=.env server/db/seed.ts",
    "test": "DATABASE_PATH=:memory: tsx --test server/tests/*.test.ts",
    "typecheck": "tsc -b",
    "check:data": "tsx scripts/check-i18n.mts && tsx scripts/check-curated.mts",
    "check": "tsc -b && npm test && npm run check:data"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@auth/express": "^0.12.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/database": "^2.0.1",
    "@tanstack/react-query": "^5.104.4",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.0.13",
    "opening_hours": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
