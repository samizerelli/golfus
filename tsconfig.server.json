{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/server.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "scripts", "vite.config.ts"],
  // Test des calculs de prix du client (exécuté par tsx, typé par le projet client)
  "exclude": ["server/tests/prices.test.ts"]
}
